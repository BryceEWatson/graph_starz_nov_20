# Graph Starz Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port for the backend server (default: 4000)
PORT=4000

# Environment mode: development | test | production
NODE_ENV=development

# ============================================
# SECURITY
# ============================================

# JWT secret key for signing tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
GRAPHSTARZ_JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ============================================
# NEO4J DATABASE
# ============================================

# Neo4j connection URI
# Local: bolt://localhost:7687
# Aura: neo4j+s://xxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687

# Neo4j authentication
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# ============================================
# GOOGLE CLOUD STORAGE (GCS)
# ============================================

# GCS bucket name for image storage (must be globally unique)
GCS_BUCKET=your-graph-starz-images-bucket

# GCP project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCS bucket location (e.g., us-central1, europe-west1)
GCP_STORAGE_LOCATION=us-central1

# Path to service account JSON (optional - can use gcloud auth instead)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ============================================
# GOOGLE GEMINI AI
# ============================================

# Gemini API key from Google AI Studio
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=AIza...your-gemini-api-key-here

# ============================================
# GOOGLE OAUTH 2.0
# ============================================

# OAuth client ID from Google Cloud Console
# Must end with .apps.googleusercontent.com
GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# OAuth client secret
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret-here

# OAuth redirect URI (must match Google Console configuration)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Frontend URL for CORS configuration
FRONTEND_ORIGIN=http://localhost:5173

# ============================================
# ACCESS CONTROL
# ============================================

# Comma-separated emails allowed to use the app (case doesn't matter).
# Anyone can sign in with Google, but people not on this list can only
# check their session and join the waitlist; every other route answers 403.
WHITELISTED_EMAILS=your.email@gmail.com,another@example.com

# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================

# Per-user limits on the routes that call Gemini (AI Muse prompts, upload
# analysis) are set in src/middleware/rateLimitMiddleware.ts, not here.

# Upload limits
# MAX_FILE_SIZE_MB=10
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Logging level: error | warn | info | debug
# LOG_LEVEL=info

# Session timeout in seconds (default: 86400 = 24 hours)
# SESSION_TIMEOUT=86400

# ============================================
# DEVELOPMENT TOOLS (Optional)
# ============================================

# Enable GraphQL playground (development only)
# ENABLE_PLAYGROUND=true

# Enable API documentation
# ENABLE_API_DOCS=true

# Neo4j Browser URL (for debugging)
# NEO4J_BROWSER_URL=http://localhost:7474

# ============================================
# NOTES
# ============================================

# 1. Never commit the actual .env file to version control
# 2. Keep .env.example updated with any new variables
# 3. Use strong, unique passwords and secrets
# 4. Rotate secrets regularly in production
# 5. Consider using a secrets manager for production deployments